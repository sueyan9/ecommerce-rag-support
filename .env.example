# LLM
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1   # 换成你的 OpenAI 兼容地址
OPENAI_MODEL=deepseek-chat                    # 或者 gpt-4o-mini 等

# Embedding 模型（本地/云端二选一）
EMBED_MODEL=BAAI/bge-small-en-v1.5           # 本地 sentence-transformers
EMBED_DEVICE=cpu                             # 或 cuda

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ecom_knowledge
